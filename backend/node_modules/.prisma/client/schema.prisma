generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

model area_conocimiento {
  id_area                                                              Int               @id @default(autoincrement())
  nombre                                                               String            @unique @db.VarChar(200)
  microcredencial_microcredencial_area_conocimientoToarea_conocimiento microcredencial[] @relation("microcredencial_area_conocimientoToarea_conocimiento")
}

model carrera {
  id_carrera                          Int       @id @default(autoincrement())
  facultad                            Int
  nombre                              String    @unique @db.VarChar(100)
  facultad_carrera_facultadTofacultad facultad  @relation("carrera_facultadTofacultad", fields: [facultad], references: [id_facultad], onDelete: NoAction, onUpdate: NoAction)
  usuario_usuario_carreraTocarrera    usuario[] @relation("usuario_carreraTocarrera")
}

model facultad {
  id_facultad                        Int       @id @default(autoincrement())
  nombre                             String    @unique @db.VarChar(100)
  carrera_carrera_facultadTofacultad carrera[] @relation("carrera_facultadTofacultad")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model insignia_emitida {
  id_insignia                                Int                   @id @default(autoincrement())
  microcredencial                            Int
  emisor                                     Int
  receptor                                   Int
  id_global                                  String                @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  url_externo                                String                @unique
  firma_jws                                  String
  certificado_publico                        String
  fecha_emision                              DateTime              @default(now()) @db.Timestamp(6)
  png_baked_url                              String?
  assertion_jsonld                           Json
  estado                                     String                @default("Activa") @db.VarChar(20)
  usuario_insignia_emitida_emisorTousuario   usuario               @relation("insignia_emitida_emisorTousuario", fields: [emisor], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction)
  microcredencial_ref                        microcredencial       @relation("microcredencial_insignias", fields: [microcredencial], references: [id_microcredencial], onDelete: NoAction, onUpdate: NoAction)
  usuario_insignia_emitida_receptorTousuario usuario               @relation("insignia_emitida_receptorTousuario", fields: [receptor], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction)
  perfil_academico                           perfil_academico[]
  revocacion_insignia                        revocacion_insignia[]

  @@unique([microcredencial, receptor])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model microcredencial {
  id_microcredencial                                                     Int                   @id @default(autoincrement())
  emisor                                                                 Int
  nombre                                                                 String                @unique @db.VarChar(300)
  descripcion                                                            String
  criterios_evaluacion                                                   String
  nivel                                                                  Int
  duracion_horas                                                         Int
  area_conocimiento                                                      Int
  competencias                                                           String[]
  imagen_url                                                             String
  metadata_ob3                                                           Json?
  estado                                                                 String                @default("Pendiente") @db.VarChar(30)
  justificacion_rechazo                                                  String?
  aprobado_por                                                           Int?
  aprobado_en                                                            DateTime?             @db.Timestamp(6)
  eliminado                                                              Boolean               @default(false)
  creado_en                                                              DateTime              @default(now()) @db.Timestamp(6)
  insignias                                                              insignia_emitida[]    @relation("microcredencial_insignias")
  usuario_microcredencial_aprobado_porTousuario                          usuario?              @relation("microcredencial_aprobado_porTousuario", fields: [aprobado_por], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction)
  area_conocimiento_microcredencial_area_conocimientoToarea_conocimiento area_conocimiento     @relation("microcredencial_area_conocimientoToarea_conocimiento", fields: [area_conocimiento], references: [id_area], onDelete: NoAction, onUpdate: NoAction)
  usuario_microcredencial_emisorTousuario                                usuario               @relation("microcredencial_emisorTousuario", fields: [emisor], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction)
  nivel_microcredencial                                                  nivel_microcredencial @relation(fields: [nivel], references: [id_nivel], onDelete: NoAction, onUpdate: NoAction)
}

model nivel_microcredencial {
  id_nivel        Int               @id @default(autoincrement())
  nombre          String            @unique @db.VarChar(150)
  microcredencial microcredencial[]
}

model perfil_academico {
  receptor         Int
  insignia         Int
  visible          Boolean          @default(true)
  orden            Int?
  insignia_emitida insignia_emitida @relation(fields: [insignia], references: [id_insignia], onDelete: Cascade, onUpdate: NoAction)
  usuario          usuario          @relation(fields: [receptor], references: [id_usuario], onDelete: Cascade, onUpdate: NoAction)

  @@id([receptor, insignia])
}

model revocacion_insignia {
  id_revocacion    Int              @id @default(autoincrement())
  insignia         Int
  revocado_por     Int
  justificacion    String
  revocado_en      DateTime         @default(now()) @db.Timestamp(6)
  insignia_emitida insignia_emitida @relation(fields: [insignia], references: [id_insignia], onDelete: NoAction, onUpdate: NoAction)
  usuario          usuario          @relation(fields: [revocado_por], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction)
}

model rol {
  id_rol                           Int           @id @default(autoincrement())
  nombre                           String        @unique @db.VarChar(50)
  descripcion                      String?
  usuario_rol_usuario_rol_rolTorol usuario_rol[] @relation("usuario_rol_rolTorol")
}

model usuario {
  id_usuario                                            Int                   @id @default(autoincrement())
  cedula                                                String                @unique @db.VarChar(255)
  nombres                                               String                @db.VarChar(200)
  apellidos                                             String                @db.VarChar(200)
  correo                                                String                @unique @db.VarChar(255)
  contrasenia                                           String
  carrera                                               Int?
  foto_url                                              String?
  activo                                                Boolean               @default(true)
  intentos_fallidos                                     Int                   @default(0)
  tiempo_bloqueo                                        DateTime?             @db.Timestamp(6)
  creado_en                                             DateTime              @default(now()) @db.Timestamp(6)
  insignia_emitida_insignia_emitida_emisorTousuario     insignia_emitida[]    @relation("insignia_emitida_emisorTousuario")
  insignia_emitida_insignia_emitida_receptorTousuario   insignia_emitida[]    @relation("insignia_emitida_receptorTousuario")
  microcredencial_microcredencial_aprobado_porTousuario microcredencial[]     @relation("microcredencial_aprobado_porTousuario")
  microcredencial_microcredencial_emisorTousuario       microcredencial[]     @relation("microcredencial_emisorTousuario")
  perfil_academico                                      perfil_academico[]
  revocacion_insignia                                   revocacion_insignia[]
  carrera_usuario_carreraTocarrera                      carrera?              @relation("usuario_carreraTocarrera", fields: [carrera], references: [id_carrera], onDelete: NoAction, onUpdate: NoAction)
  usuario_rol_usuario_rol_asignado_porTousuario         usuario_rol[]         @relation("usuario_rol_asignado_porTousuario")
  usuario_rol_usuario_rol_usuarioTousuario              usuario_rol[]         @relation("usuario_rol_usuarioTousuario")
}

model usuario_rol {
  usuario                                   Int
  rol                                       Int
  asignado_por                              Int?
  usuario_usuario_rol_asignado_porTousuario usuario? @relation("usuario_rol_asignado_porTousuario", fields: [asignado_por], references: [id_usuario], onDelete: NoAction, onUpdate: NoAction)
  rol_usuario_rol_rolTorol                  rol      @relation("usuario_rol_rolTorol", fields: [rol], references: [id_rol], onDelete: Cascade, onUpdate: NoAction)
  usuario_usuario_rol_usuarioTousuario      usuario  @relation("usuario_rol_usuarioTousuario", fields: [usuario], references: [id_usuario], onDelete: Cascade, onUpdate: NoAction)

  @@id([usuario, rol])
}
