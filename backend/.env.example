# ==============================================================================
# ARCHIVO DE CONFIGURACIÓN DE EJEMPLO (PLANTILLA)
# Copie este archivo como .env y configure los valores según su entorno.
# ==============================================================================

# Configuración del Servidor
PORT=3000
NODE_ENV=development

# Base de Datos PostgreSQL
# Formato: postgresql://<usuario>:<contraseña>@<host>:<puerto>/<nombre_bd>?schema=public
DATABASE_URL="postgresql://postgres:tu_contrasenia@127.0.0.1:5432/Microcredenciales_ESPOCH?schema=public"

# Seguridad y Criptografía
# Clave secreta para firma y verificación de JSON Web Tokens (HS256)
JWT_SECRET="cambiar_por_una_clave_jwt_segura_y_aleatoria_para_produccion"

# Clave secreta para cifrado simétrico AES-256-CBC de la clave privada institucional (Mínimo 32 caracteres)
AES_SECRET_KEY="cambiar_por_clave_aes_256_de_32_bytes_minimo!!"

# URLs de la Aplicación
URL_BACKEND=http://localhost:3000
URL_FRONTEND=http://localhost:4200

